@import "tailwindcss" source(none);
@source "../src";
@import "tw-animate-css";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
  --radius-2xl: calc(var(--radius) + 8px);
  --radius-3xl: calc(var(--radius) + 12px);
  --radius-4xl: calc(var(--radius) + 16px);
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-surface: var(--surface);
  --color-surface-2: var(--surface-2);
  --font-sans: "Outfit", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Outfit", ui-sans-serif, system-ui, sans-serif;
}

:root {
  /* Universal brand color controls */
  --brand-primary: oklch(0.68 0.19 42);
  --brand-primary-foreground: oklch(0.99 0 0);
  --brand-secondary: oklch(0.24 0.005 60);
  --brand-secondary-foreground: oklch(0.98 0 0);

  --radius: 1rem;
  --background: oklch(0.16 0.004 60);
  --foreground: oklch(0.98 0 0);
  --card: oklch(0.2 0.004 60);
  --card-foreground: oklch(0.98 0 0);
  --popover: oklch(0.2 0.004 60);
  --popover-foreground: oklch(0.98 0 0);
  --primary: var(--brand-primary);
  --primary-foreground: var(--brand-primary-foreground);
  --secondary: var(--brand-secondary);
  --secondary-foreground: var(--brand-secondary-foreground);
  --muted: oklch(0.24 0.005 60);
  --muted-foreground: oklch(0.72 0.01 60);
  --accent: var(--brand-primary);
  --accent-foreground: var(--brand-primary-foreground);
  --destructive: oklch(0.6 0.22 27);
  --destructive-foreground: oklch(0.99 0 0);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 12%);
  --ring: var(--brand-primary);
  --surface: oklch(0.2 0.004 60);
  --surface-2: oklch(0.24 0.005 60);
  --shadow-glow: 0 0 60px -12px oklch(from var(--brand-primary) l c h / 0.55);
  --gradient-fade-bottom: linear-gradient(
    120deg,
    oklch(0.72 0.16 255) 0%,
    oklch(0.98 0 0) 45%,
    oklch(0.76 0.18 55) 75%,
    oklch(0.72 0.16 255) 100%
  );
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
}

/* Animated tricolor wordmark gradient */
@utility text-fade-bottom {
  background: var(--gradient-fade-bottom);
  background-size: 220% 220%;
  animation: hero-gradient-shift 3.8s ease-in-out infinite;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

@keyframes hero-gradient-shift {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

/* Orange-only animated wordmark with thin glass outline (applies at all sizes) */
.hero-wordmark-glass {
  background: linear-gradient(90deg, #ffd19a 0%, #ff7000 100%);
  background-size: 200% 200%;
  animation: hero-gradient-shift 3.8s ease-in-out infinite;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-stroke: 0.5px rgba(255, 255, 255, 0.14);
  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.02), 0 0 12px rgba(255,112,0,0.06);
}

@utility glow-ring {
  box-shadow: var(--shadow-glow);
}

/* Seamless infinite marquee */
@utility marquee-track {
  display: flex;
  width: max-content;
  animation: marquee-scroll var(--marquee-duration, 40s) linear infinite;
}

@utility marquee-track-reverse {
  display: flex;
  width: max-content;
  animation: marquee-scroll var(--marquee-duration, 40s) linear infinite reverse;
}

@keyframes marquee-scroll {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-50%);
  }
}

.marquee-pause:hover .marquee-track,
.marquee-pause:hover .marquee-track-reverse {
  animation-play-state: paused;
}

/* Reveal on scroll */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition:
    opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
    transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  transition-delay: var(--reveal-delay, 0ms);
}

.reveal.is-visible {
  opacity: 1;
  transform: none;
}

@media (prefers-reduced-motion: reduce) {
  .reveal {
    opacity: 1;
    transform: none;
  }
  .text-fade-bottom {
    animation: none;
    background-position: 50% 50%;
  }
  .marquee-track,
  .marquee-track-reverse {
    animation: none;
  }
}

@keyframes rise-in {
  from {
    opacity: 0;
    transform: translateY(36px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.animate-rise {
  animation: rise-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes soft-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.animate-soft-pulse {
  animation: soft-pulse 2s ease-in-out infinite;
}

@keyframes float-y {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10px);
  }
}

.animate-float {
  animation: float-y 6s ease-in-out infinite;
}

/* Desktop: the hero section and the clients marquee live in one shared
   lg:h-svh block (see index.tsx), so every size below is capped as a share
   of viewport height (svh) rather than a fixed rem value. That's what lets
   the whole group — heading, portrait, wordmark, and the marquee row below
   it — settle inside exactly one screen: each piece shrinks together on
   short/laptop screens and grows together on tall ones, instead of the
   wordmark or portrait quietly claiming space the marquee needed.
   The wrapping flex gap (see the gap-[clamp(...)] on the hero's inner
   container) picks up any space left over once these caps are hit, so nudge
   these numbers up first if you see extra empty space on your screen, and
   down first if the marquee ever gets pushed below the fold. */
@media (min-width: 1024px) {
  .hero-media {
    max-width: min(34rem, 46svh);
  }
  .hero-wordmark {
    font-size: min(16vw, 18svh);
  }
  /* moved .hero-wordmark-glass to global scope for mobile support */
  .hero-title {
    font-size: clamp(4rem, 4.9vw, 5.2rem);
  }
  .hero-sub {
    font-size: clamp(1.08rem, 1.2vw, 1.25rem);
  }
}
</file>

